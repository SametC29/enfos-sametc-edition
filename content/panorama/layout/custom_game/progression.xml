<root>
	<styles>
		<include src="file://{resources}/styles/dotastyles.css" />
		<include src="file://{resources}/styles/custom_game/progression.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/progression.js" />
	</scripts>
	<Panel class="ProgressionRoot" hittest="false">
		<!-- Toggle Button on Top Right -->
		<Button id="ToggleProgressionBtn" class="ToggleBtn" onactivate="ToggleProgressionPanel()">
			<Label id="ToggleBtnLabel" text="#enfos_progression_title" />
		</Button>

		<!-- Main Panel (Initially Hidden) -->
		<Panel id="ProgressionPanel" class="ProgressionPanel Hidden">
			<!-- Header -->
			<Panel class="ProgHeader">
				<Label class="ProgTitle" text="#enfos_progression_title" />
				<Button class="CloseBtn" onactivate="ToggleProgressionPanel()">
					<Label text="✕" />
				</Button>
			</Panel>

			<!-- Account Level & XP Bar -->
			<Panel class="AccountSection">
				<Panel class="LevelRow">
					<Label id="AccountLevelLabel" class="LevelText" text="Seviye 1" />
					<Label id="AccountXpLabel" class="XpText" text="0 / 500 XP" />
				</Panel>
				<Panel class="XpBarTrack">
					<Panel id="XpBarProgress" class="XpBarProgress" />
				</Panel>
			</Panel>

			<!-- Legacy Tree Section -->
			<Panel class="LegacySection">
				<Panel class="LegacyHeaderRow">
					<Label class="LegacyTitle" text="#enfos_legacy_title" />
					<Label id="UnspentPointsLabel" class="UnspentPointsText" text="Kullanılabilir Puan: 0" />
					<Button id="RespecBtn" class="RespecBtn" onactivate="RespecLegacy()">
						<Label text="#enfos_legacy_respec" />
					</Button>
				</Panel>

				<!-- 4 Branches -->
				<Panel class="BranchesGrid">
					<!-- Offense -->
					<Panel class="BranchCard">
						<Label class="BranchName" text="#enfos_legacy_offense" />
						<Label id="OffenseDesc" class="BranchDesc" text="+0.0% PvE Hasarı" />
						<Panel class="BranchControl">
							<Label id="OffenseRank" class="RankText" text="0 / 12" />
							<Button id="OffensePlusBtn" class="PlusBtn" onactivate="AllocateRank('offense')">
								<Label text="+" />
							</Button>
						</Panel>
					</Panel>

					<!-- Defense -->
					<Panel class="BranchCard">
						<Label class="BranchName" text="#enfos_legacy_defense" />
						<Label id="DefenseDesc" class="BranchDesc" text="+0.0% Azami Can" />
						<Panel class="BranchControl">
							<Label id="DefenseRank" class="RankText" text="0 / 12" />
							<Button id="DefensePlusBtn" class="PlusBtn" onactivate="AllocateRank('defense')">
								<Label text="+" />
							</Button>
						</Panel>
					</Panel>

					<!-- Economy -->
					<Panel class="BranchCard">
						<Label class="BranchName" text="#enfos_legacy_economy" />
						<Label id="EconomyDesc" class="BranchDesc" text="+0.0% Altın Verimi" />
						<Panel class="BranchControl">
							<Label id="EconomyRank" class="RankText" text="0 / 12" />
							<Button id="EconomyPlusBtn" class="PlusBtn" onactivate="AllocateRank('economy')">
								<Label text="+" />
							</Button>
						</Panel>
					</Panel>

					<!-- Spellbringer -->
					<Panel class="BranchCard">
						<Label class="BranchName" text="#enfos_legacy_spellbringer" />
						<Label id="SpellbringerDesc" class="BranchDesc" text="+0.0% Büyücü Verimi" />
						<Panel class="BranchControl">
							<Label id="SpellbringerRank" class="RankText" text="0 / 12" />
							<Button id="SpellbringerPlusBtn" class="PlusBtn" onactivate="AllocateRank('spellbringer')">
								<Label text="+" />
							</Button>
						</Panel>
					</Panel>
				</Panel>
			</Panel>

			<!-- Difficulty & Hero Mastery Footer -->
			<Panel class="FooterSection">
				<Label id="DifficultyLabel" class="FooterText" text="Açık Zorluk: Normal" />
				<Label id="HeroMasteryLabel" class="FooterText" text="Kahraman Ustalığı: Seviye 1" />
			</Panel>
		</Panel>
	</Panel>
</root>
