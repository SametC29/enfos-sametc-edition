<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/wave_hud.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/wave_hud.js" />
    </scripts>
    <Panel class="EnfosWaveHudRoot" hittest="false">
        <!-- Top Bar Center Custom Container: replaces Day/Night & 0-0 score -->
        <Panel id="EnfosTopBarCenter" class="EnfosTopBarCenter" hittest="false">
            <!-- Left: Goodguys / Radiant Life (starts at 100) -->
            <Panel id="RadiantLifeContainer" class="TeamLifeBox RadiantLifeBox">
                <Panel class="LifeNumberRow">
                    <Panel class="LifeShieldIcon RadiantShield" />
                    <Label id="RadiantLifeNumber" class="LifeNumber" text="100" />
                </Panel>
                <Panel class="LifeTrack">
                    <Panel id="RadiantLifeBarFill" class="LifeFill RadiantLifeFill" />
                </Panel>
            </Panel>

            <!-- Center: Wave Number (replaces Day/Night icon) & Countdown (replaces GameTime) -->
            <Panel id="WaveCenterBadge" class="WaveCenterBadge">
                <Panel class="WaveNumberRow">
                    <Label id="TopWaveTitle" class="TopWaveTitle" text="DALGA 1 / 60" />
                    <Button id="GuideBtn" class="TopGuideBtn" onactivate="ToggleGuide()"><Label text="?" /></Button>
                    <Button id="ToggleDamageTableBtn" class="TopScoreboardBtn" onactivate="ToggleEnfosScoreboard()"><Label text="SKOR" /></Button>
                </Panel>
                <Label id="TopWaveTimer" class="TopWaveTimer" text="00:45" />
            </Panel>

            <!-- Right: Badguys / Dire Life (starts at 100) -->
            <Panel id="DireLifeContainer" class="TeamLifeBox DireLifeBox">
                <Panel class="LifeNumberRow">
                    <Label id="DireLifeNumber" class="LifeNumber" text="100" />
                    <Panel class="LifeShieldIcon DireShield" />
                </Panel>
                <Panel class="LifeTrack">
                    <Panel id="DireLifeBarFill" class="LifeFill DireLifeFill" />
                </Panel>
            </Panel>
        </Panel>

        <!-- Centered Boss Alert Notification -->
        <Panel id="BossAlertPanel" class="BossAlertPanel Hidden" hittest="false">
            <Label id="BossAlertText" text="! BOSS DALGASI BAŞLADI !" />
        </Panel>
    </Panel>
</root>
