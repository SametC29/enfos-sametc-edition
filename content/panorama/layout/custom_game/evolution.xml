<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/evolution.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/evolution.js" />
	</scripts>

	<Panel class="EvolutionRoot" hittest="false">
		<!-- Compact Floating HUD Badge (Always visible during game when choices are pending) -->
		<Button id="EvoBadgeButton" class="EvoBadge EvoBadgeHidden" onactivate="EnfosEvolution.ToggleModal()">
			<Label class="EvoBadgeIcon" text="⚡" />
			<Label id="EvoBadgeText" class="EvoBadgeText" text="1 Gelişim Seçimi!" />
		</Button>

		<!-- Modal Dialog (Opens when milestone reached or badge clicked) -->
		<Panel id="EvoModal" class="EvoModalRoot EvoModalHidden" hittest="true">
			<Panel id="EvoModalBackdrop" class="EvoBackdrop" onactivate="EnfosEvolution.Defer()" />
			<Panel class="EvoDialog">
				<!-- Header -->
				<Panel class="EvoHeader">
					<Label id="EvoMilestoneTitle" class="EvoTitle" text="KAHRAMAN GELİŞİMİ — SEVİYE 4" />
					<Label class="EvoSubtitle" text="Aşağıdaki 2 gelişim yolundan birini seçerek kahramanını uzmanlaştır." />
				</Panel>

				<!-- Cards Row -->
				<Panel id="EvoCardsRow" class="EvoCardsRow">
					<!-- Card 1 -->
					<Panel id="EvoCard1" class="EvoCard">
						<DOTAAbilityImage id="EvoCardIcon1" class="EvoCardIcon" abilityname="" />
						<Label id="EvoCardTitle1" class="EvoCardTitle" text="Dalga Biçici" />
						<Label id="EvoCardDesc1" class="EvoCardDesc" text="+%25 AoE Yetenek Hasarı ve %40 Alan Yarma." />
						<Button id="EvoCardBtn1" class="EvoSelectBtn" onactivate="EnfosEvolution.SelectChoice(1)">
							<Label text="SEÇ / CHOOSE" />
						</Button>
					</Panel>

					<!-- Card 2 -->
					<Panel id="EvoCard2" class="EvoCard">
						<DOTAAbilityImage id="EvoCardIcon2" class="EvoCardIcon" abilityname="" />
						<Label id="EvoCardTitle2" class="EvoCardTitle" text="Dev Katili" />
						<Label id="EvoCardDesc2" class="EvoCardDesc" text="Boss ve Seçkin yaratıklara karşı +%35 hasar." />
						<Button id="EvoCardBtn2" class="EvoSelectBtn" onactivate="EnfosEvolution.SelectChoice(2)">
							<Label text="SEÇ / CHOOSE" />
						</Button>
					</Panel>
				</Panel>

				<!-- Footer: Defer Button (Match never pauses, player can defer anytime) -->
				<Panel class="EvoFooter">
					<Button class="EvoDeferBtn" onactivate="EnfosEvolution.Defer()">
						<Label text="DAHA SONRA SEÇ (SIRAYA AL)" />
					</Button>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
