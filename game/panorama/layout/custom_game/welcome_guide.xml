<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/welcome_guide.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/welcome_guide.js" />
	</scripts>

	<Panel class="WelcomeGuideRoot WelcomeGuideHidden" hittest="false">
		<Panel id="WelcomeGuideBackdrop" hittest="true" onactivate="EnfosWelcomeGuide.CloseGuide()" />

		<Panel class="WelcomeGuideDialog">
			<!-- Header -->
			<Panel class="GuideHeader">
				<Panel class="GuideTitleRow">
					<Label class="GuideTitle" text="ENFOS TEAM SURVIVAL" />
					<Button class="GuideCloseBtn" onactivate="EnfosWelcomeGuide.CloseGuide()">
						<Label text="✕" />
					</Button>
				</Panel>
				<Label class="GuideSubtitle" text="HIZLI BAŞLANGIÇ & OYUN REHBERİ • QUICK START GUIDE" />
				<Panel class="GuideGoldLine" />
			</Panel>

			<!-- Content Columns -->
			<Panel class="GuideColumnsContainer">
				<!-- Column 1: Core Rules & Waves -->
				<Panel class="GuideColumn">
					<Label class="ColumnHeader" text="TEMEL KURALLAR & DALGALAR" />
					
					<Panel class="GuideRow">
						<Label class="RowBullet" text="•" />
						<Label class="RowText" text="Takım Canı 100 ile başlar. Koridorlardaki birim sınırı aşıldığında biriken fazlalık düşmanlar doğrudan can kaybı yaratır." />
					</Panel>

					<Panel class="GuideRow">
						<Label class="RowBullet" text="•" />
						<Label class="RowText" text="Toplam 60 Dalga: Her 5. dalga yalnız bir Boss içerir ve Kereste kazandırır. Her 6. dalga Elit yaratıklar çıkarır." />
					</Panel>

					<Panel class="GuideRow">
						<Label class="RowBullet" text="•" />
						<Label class="RowText" text="Spellbringer (F3): Ayrı manaya sahip büyü taşıyıcınız ile acil durumlarda takımı kurtarabilir veya rakip takımı zora sokabilirsiniz." />
					</Panel>
				</Panel>

				<!-- Column 2: Economy & Ascended -->
				<Panel class="GuideColumn">
					<Label class="ColumnHeader" text="EKONOMİ & YÜKSELMİŞ EŞYALAR" />
					
					<Panel class="GuideRow">
						<Label class="RowBullet" text="•" />
						<Label class="RowText" text="Yükselmiş Dükkan (B): Boss dalgalarından gelen Kereste ile normal eşyalarınızı efsanevi Yükselmiş kademeye geçirin." />
					</Panel>

					<Panel class="GuideRow">
						<Label class="RowBullet" text="•" />
						<Label class="RowText" text="Aghanim'in Lütfu: Aghanim'in Asasını tüketerek envanter yuvasını serbest bırakır ve bonuslarını kalıcı olarak korur." />
					</Panel>

					<Panel class="GuideRow">
						<Label class="RowBullet" text="•" />
						<Label class="RowText" text="Gelişim Seçimleri (N): Seviye 4, 7, 10, 13, 16 ve 19'da oyun tarzınızı özelleştiren dallar seçin veya sıraya alın." />
					</Panel>
				</Panel>

				<!-- Column 3: Shortcuts & Controls -->
				<Panel class="GuideColumn">
					<Label class="ColumnHeader" text="KISAYOLLAR & KONTROLLER" />
					
					<Panel class="ShortcutRow">
						<Panel class="KeyBadge"><Label text="F1" /></Panel>
						<Label class="ShortcutDesc" text="Kahramanı Seç" />
					</Panel>

					<Panel class="ShortcutRow">
						<Panel class="KeyBadge"><Label text="F2" /></Panel>
						<Label class="ShortcutDesc" text="Kuryeyi Seç" />
					</Panel>

					<Panel class="ShortcutRow">
						<Panel class="KeyBadge"><Label text="F3" /></Panel>
						<Label class="ShortcutDesc" text="Spellbringer'ı Seç" />
					</Panel>

					<Panel class="ShortcutRow">
						<Panel class="KeyBadge"><Label text="B" /></Panel>
						<Label class="ShortcutDesc" text="Yükselmiş Dükkan (Ascended Shop)" />
					</Panel>

					<Panel class="ShortcutRow">
						<Panel class="KeyBadge"><Label text="N" /></Panel>
						<Label class="ShortcutDesc" text="Gelişim Kuyruğu (Milestones)" />
					</Panel>

					<Panel class="ShortcutRow">
						<Panel class="KeyBadge"><Label text="V" /></Panel>
						<Label class="ShortcutDesc" text="Kutsama Oylaması (Boon Vote)" />
					</Panel>
				</Panel>
			</Panel>

			<!-- Footer Action -->
			<Panel class="GuideFooter">
				<Button class="GuideReadyButton" onactivate="EnfosWelcomeGuide.CloseGuide()">
					<Label text="ANLADIM, SAVAŞA BAŞLA / READY" />
				</Button>
			</Panel>
		</Panel>
	</Panel>
</root>
