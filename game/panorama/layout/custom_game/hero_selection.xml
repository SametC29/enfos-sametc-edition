<root>
    <styles>
        <include src="s2r://panorama/styles/dotastyles.vcss_c" />
        <include src="file://{resources}/styles/custom_game/hero_selection.css" />
    </styles>
    <scripts><include src="file://{resources}/scripts/custom_game/hero_selection.js" /></scripts>
    <Panel class="HeroSelectionRoot HeroSelectionHidden" hittest="true">
        <Panel class="SelectionShell">
            <Panel class="SelectionHeader">
                <Panel class="HeadingBlock">
                    <Label class="Eyebrow" text="#enfos_select_eyebrow" />
                    <Label class="ScreenTitle" text="#enfos_select_title" />
                    <Label class="ScreenSubtitle" text="#enfos_select_subtitle" />
                </Panel>
                <Panel class="TimerContainer">
                    <Label class="TimerCaption" text="#enfos_select_time" />
                    <Label id="SelectTimerLabel" class="TimerNumber" text="—" />
                </Panel>
            </Panel>
            <Panel class="SelectionBody">
                <Panel class="RosterPanel">
                    <Panel class="RoleSection"><Label class="RoleHeader" text="#enfos_role_tank" /><Panel id="TopRoleHeroes" class="HeroRow" /></Panel>
                    <Panel class="RoleSection"><Label class="RoleHeader" text="#enfos_role_fighter" /><Panel id="LeftRoleHeroes" class="HeroRow" /></Panel>
                    <Panel class="RoleSection"><Label class="RoleHeader" text="#enfos_role_carry" /><Panel id="CarryRoleHeroes" class="HeroRow" /></Panel>
                    <Panel class="RoleSection"><Label class="RoleHeader" text="#enfos_role_mage" /><Panel id="BottomRoleHeroes" class="HeroRow" /></Panel>
                    <Panel class="RoleSection"><Label class="RoleHeader" text="#enfos_role_support" /><Panel id="RightRoleHeroes" class="HeroRow" /></Panel>
                </Panel>
                <Panel class="ShowcasePanel">
                    <Image id="ShowcaseHeroImage" class="ShowcaseHeroImg" scaling="stretch-to-fit-preserve-aspect" />
                    <Label id="ShowcaseHeroTitle" class="HeroTitleText" text="#enfos_select_loading" />
                    <Panel class="BadgesRow"><Label id="RoleBadgeText" class="RoleBadge" /><Label id="AttrBadgeText" class="AttributeBadge" /></Panel>
                    <Label class="AbilityHeading" text="#enfos_select_abilities" />
                    <Panel id="ShowcaseAbilities" class="AbilitiesRow" />
                    <Label class="AbilityHint" text="#enfos_select_ability_hint" />
                    <Panel class="SelectionFooter">
                        <Label id="PickStatus" class="PickStatus" text="#enfos_select_hint" />
                        <Button id="PickHeroBtn" class="PickHeroButton" onactivate="EnfosHeroSelect.PickCurrentHero()" enabled="false"><Label id="PickHeroBtnLabel" text="#enfos_select_pick" /></Button>
                    </Panel>
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>
