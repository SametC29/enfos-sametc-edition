<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/custom_loading_screen.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/custom_loading_screen.js" />
	</scripts>

	<Panel class="LoadingRoot">
		<!-- Dark Atmospheric Backdrop with Golden Ambient Glow -->
		<Panel id="LoadingBackdrop" />
		<Panel class="VignetteOverlay" />

		<!-- Center Loading Container -->
		<Panel class="LoadingContent">
			<!-- Title & Branding -->
			<Panel class="TitleContainer">
				<Label class="MainTitle" text="#enfos_loading_title" />
				<Label class="SubTitle" text="#enfos_loading_subtitle" />
				<Panel class="GoldDivider" />
			</Panel>

			<!-- 4 Pillars of Gameplay Showcase -->
			<Panel class="PillarsContainer">
				<!-- Pillar 1: 60 Waves -->
				<Panel class="PillarCard">
					<Panel class="PillarHeader">
						<Panel class="PillarIcon IconWaves" />
						<Label class="PillarTitle" text="#enfos_loading_wave_title" />
					</Panel>
					<Label class="PillarDesc" text="#enfos_loading_wave_format" />
				</Panel>

				<!-- Pillar 2: 100 Team Life -->
				<Panel class="PillarCard">
					<Panel class="PillarHeader">
						<Panel class="PillarIcon IconLife" />
						<Label class="PillarTitle" text="#enfos_loading_core_title" />
					</Panel>
					<Label class="PillarDesc" text="#enfos_loading_core_format" />
				</Panel>

				<!-- Pillar 3: Spellbringer -->
				<Panel class="PillarCard">
					<Panel class="PillarHeader">
						<Panel class="PillarIcon IconSpellbringer" />
						<Label class="PillarTitle" text="#enfos_loading_spellbringer_title" />
					</Panel>
						<Label class="PillarDesc" text="#enfos_loading_spellbringer_desc" />
				</Panel>

				<!-- Pillar 4: Ascended Forge -->
				<Panel class="PillarCard">
					<Panel class="PillarHeader">
						<Panel class="PillarIcon IconAscended" />
						<Label class="PillarTitle" text="#enfos_loading_ascended_title" />
					</Panel>
						<Label class="PillarDesc" text="#enfos_loading_ascended_desc" />
				</Panel>
			</Panel>

			<!-- Rotating Strategy Tips Box -->
			<Panel class="TipContainer">
				<Panel class="TipHeaderRow">
				<Panel class="TipBadge"><Label text="#enfos_loading_tip_label" /></Panel>
					<Label id="TipCategory" class="TipCategoryText" text="#enfos_loading_tip_economy" />
				</Panel>
				<Label id="StrategyTipText" class="StrategyTipLabel" text="#enfos_loading_tip_economy_desc" />
			</Panel>

			<!-- Loading Progress Bar & Indicator -->
			<Panel class="ProgressSection">
				<Panel class="StatusRow">
					<Panel class="LoadingSpinner" />
					<Label id="LoadingStatus" class="StatusText" text="#enfos_loading_status" />
				</Panel>
				<Panel class="ProgressBarTrack">
					<Panel id="ProgressBarFill" class="ProgressBarThumb" />
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
