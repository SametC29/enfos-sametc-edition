<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/custom_scoreboard.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/custom_scoreboard.js" />
    </scripts>
    <Panel class="EnfosScoreboardRoot" hittest="false">
        <Panel id="ScoreboardContainer" class="ScoreboardContainer">
            <!-- Header -->
            <Panel class="ScoreboardHeader">
                <Panel class="ScoreboardTitleGroup">
                    <Label class="ScoreboardTitle" text="#enfos_brand" />
                    <Label class="ScoreboardSubtitle" text="#enfos_score_title" />
                </Panel>
                <Panel class="ScoreboardControls">
                    <Label class="ScoreboardTip" text="#enfos_score_hint" />
                    <Button id="ScoreboardCloseBtn" class="ScoreboardCloseBtn" onactivate="CloseScoreboard()">
                        <Label text="✕" />
                    </Button>
                </Panel>
            </Panel>

            <!-- Column Legend -->
            <Panel class="ScoreboardLegend">
                <Label class="Col_Hero" text="#enfos_score_hero" />
                <Label class="Col_Player" text="#enfos_score_player" />
                <Label class="Col_Level" text="#enfos_hud_level" />
                <Label class="Col_Damage" text="#enfos_score_damage" />
                <Label class="Col_Kills" text="#enfos_score_kills" />
                <Label class="Col_Gold" text="#enfos_score_gold" />
                <Label class="Col_Lumber" text="#enfos_score_lumber" />
                <Label class="Col_Items" text="#enfos_score_items" />
            </Panel>

            <!-- Teams Area -->
            <Panel id="TeamsContainer" class="TeamsContainer">
                <!-- Radiant Team Block -->
                <Panel id="RadiantTeamBlock" class="TeamBlock RadiantTeam">
                    <Panel class="TeamHeaderRow RadiantHeader">
                        <Panel class="TeamNameRow">
                            <Panel class="TeamColorBar RadiantColorBar" />
                            <Label class="TeamName" text="#DOTA_GoodGuys" />
                        </Panel>
                        <Panel class="TeamSummaryRow">
                            <Label id="RadiantTotalDamage" class="TeamSummaryText" text="0" />
                            <Label id="RadiantTotalKills" class="TeamSummaryText" text="0" />
                            <Panel class="TeamScoreBadge">
                                <Label text="#enfos_score_life" class="TeamLifeLabel" />
                                <Label id="RadiantScoreboardLife" class="TeamLifeVal" text="100 / 100" />
                            </Panel>
                        </Panel>
                    </Panel>
                    <Panel id="RadiantPlayersList" class="PlayersList" />
                </Panel>

                <!-- Dire Team Block -->
                <Panel id="DireTeamBlock" class="TeamBlock DireTeam">
                    <Panel class="TeamHeaderRow DireHeader">
                        <Panel class="TeamNameRow">
                            <Panel class="TeamColorBar DireColorBar" />
                            <Label class="TeamName" text="#DOTA_BadGuys" />
                        </Panel>
                        <Panel class="TeamSummaryRow">
                            <Label id="DireTotalDamage" class="TeamSummaryText" text="0" />
                            <Label id="DireTotalKills" class="TeamSummaryText" text="0" />
                            <Panel class="TeamScoreBadge">
                                <Label text="#enfos_score_life" class="TeamLifeLabel" />
                                <Label id="DireScoreboardLife" class="TeamLifeVal" text="100 / 100" />
                            </Panel>
                        </Panel>
                    </Panel>
                    <Panel id="DirePlayersList" class="PlayersList" />
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>
