<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/custom_scoreboard.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/custom_scoreboard.js" />
    </scripts>
    <Panel class="EnfosScoreboardRoot" hittest="false">
        <Panel id="ScoreboardContainer" class="ScoreboardContainer">
            <!-- Header -->
            <Panel class="ScoreboardHeader">
                <Panel class="ScoreboardTitleGroup">
                    <Label class="ScoreboardTitle" text="ENFOS TEAM SURVIVAL" />
                    <Label class="ScoreboardSubtitle" text="HASAR VE SAVAŞ TABLOSU" />
                </Panel>
                <Panel class="ScoreboardControls">
                    <Label class="ScoreboardTip" text="[TAB] Aç / Kapat" />
                    <Button id="ScoreboardCloseBtn" class="ScoreboardCloseBtn" onactivate="CloseScoreboard()">
                        <Label text="✕" />
                    </Button>
                </Panel>
            </Panel>

            <!-- Column Legend -->
            <Panel class="ScoreboardLegend">
                <Label class="Col_Hero" text="KAHRAMAN" />
                <Label class="Col_Player" text="OYUNCU" />
                <Label class="Col_Level" text="SV" />
                <Label class="Col_Damage" text="VERİLEN TOPLAM HASAR" />
                <Label class="Col_Kills" text="ÖLDÜRÜLEN DÜŞMAN" />
                <Label class="Col_Gold" text="KAZANILAN ALTIN" />
                <Label class="Col_Lumber" text="ODUN" />
                <Label class="Col_Items" text="EŞYALAR" />
            </Panel>

            <!-- Teams Area -->
            <Panel id="TeamsContainer" class="TeamsContainer">
                <!-- Radiant Team Block -->
                <Panel id="RadiantTeamBlock" class="TeamBlock RadiantTeam">
                    <Panel class="TeamHeaderRow RadiantHeader">
                        <Panel class="TeamNameRow">
                            <Panel class="TeamColorBar RadiantColorBar" />
                            <Label class="TeamName" text="AYDINLIK (RADİANT)" />
                        </Panel>
                        <Panel class="TeamSummaryRow">
                            <Label id="RadiantTotalDamage" class="TeamSummaryText" text="Takım Hasarı: 0" />
                            <Label id="RadiantTotalKills" class="TeamSummaryText" text="Takım Düşman: 0" />
                            <Panel class="TeamScoreBadge">
                                <Label text="CAN: " class="TeamLifeLabel" />
                                <Label id="RadiantScoreboardLife" class="TeamLifeVal" text="100 / 100" />
                            </Panel>
                        </Panel>
                    </Panel>
                    <Panel id="RadiantPlayersList" class="PlayersList" />
                </Panel>

                <!-- Dire Team Block -->
                <Panel id="DireTeamBlock" class="TeamBlock DireTeam">
                    <Panel class="TeamHeaderRow DireHeader">
                        <Panel class="TeamNameRow">
                            <Panel class="TeamColorBar DireColorBar" />
                            <Label class="TeamName" text="KARANLIK (DİRE)" />
                        </Panel>
                        <Panel class="TeamSummaryRow">
                            <Label id="DireTotalDamage" class="TeamSummaryText" text="Takım Hasarı: 0" />
                            <Label id="DireTotalKills" class="TeamSummaryText" text="Takım Düşman: 0" />
                            <Panel class="TeamScoreBadge">
                                <Label text="CAN: " class="TeamLifeLabel" />
                                <Label id="DireScoreboardLife" class="TeamLifeVal" text="100 / 100" />
                            </Panel>
                        </Panel>
                    </Panel>
                    <Panel id="DirePlayersList" class="PlayersList" />
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>
