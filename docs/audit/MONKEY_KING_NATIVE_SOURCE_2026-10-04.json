  "englishTokens": [
    "\t\t\"DOTA_Tooltip_ability_monkey_king_tree_dance\"\t\t\t\t\"Tree Dance\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_tree_dance_Description\"\t\"Monkey King jumps to a tree and perches atop it. While perched, he gains the Primal Spring ability-a channeled leap attack. If Monkey King's tree is destroyed, he falls and is stunned for %unperched_stunned_duration%s. Taking damage while on the ground puts Tree Dance on cooldown.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_tree_dance_Facet_monkey_king_simian_stride\"\t\"Increases the max level of Tree Dance. Level %max_level% Tree Dance reduces the cooldown to zero.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_tree_dance_Lore\"\t\t\t\"Sun Wukong dances nimbly along the treetop canopy, always just out of arm's reach.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_tree_dance_Note0\"\t\t\t\"Tree Dance cooldown starts upon landing.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_tree_dance_Note1\"\t\t\t\"Right-clicking the ground will have Monkey King drop from the tree.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_tree_dance_Note2\"\t\t\t\"Movement is interrupted if Monkey King is stunned, hexed or banished.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_tree_dance_perched_jump_distance\"\t\"DISTANCE:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_tree_dance_jump_damage_cooldown\"\t\"DAMAGE COOLDOWN:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_primal_spring\"\t\t\t\t\t\"Primal Spring\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_primal_spring_Description\"\t\t\"CHANNELED - Monkey King springs out from his tree perch, damaging and slowing enemies in the area where he lands. Damage and slow amounts are in proportion to channel duration.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_primal_spring_Lore\"\t\t\t\t\"Leaping from the safety of cover into the midst of his enemies, Sun Wukong attacks without mercy.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_primal_spring_impact_damage\"\t\t\t\"DAMAGE:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_primal_spring_impact_movement_slow\"\t\"%MOVEMENT SLOW:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_primal_spring_impact_slow_duration\"\t\"MAX SLOW DURATION:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_primal_spring_max_distance\"\t\t\t\"MAX DISTANCE:\"",
    "\t\t\"DOTA_Tooltip_Ability_monkey_king_primal_spring_early\"\t\t\t\t\t\"Spring Early\"",
    "\t\t\"DOTA_Tooltip_Ability_monkey_king_primal_spring_abilitychanneltime\"\t\t\"MAX CHANNEL TIME:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_boundless_strike\"\t\t\t\t\t\t\"Boundless Strike\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_boundless_strike_Description\"\t\t\t\"Monkey King enlarges his staff and slams it against the ground, stunning enemies in a line and damaging them with bonus damage and a critical hit based on his attack. Has True Strike.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_boundless_strike_Lore\"\t\t\t\t\"The legendary Jingu Bang grows to match its master's will, ensuring no enemy can escape the Monkey King's reach.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_boundless_strike_shard_Description\"\t\t\t\"Boundless Strike applies Primal Spring with %spring_channel_pct%%% of the max channeling duration power to enemies along the staff and at the end of the staff. When Boundless Strike is set to alt-cast, Monkey King leaps to the end of his staff.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_boundless_strike_strike_cast_range\"\t\"DISTANCE:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_boundless_strike_stun_duration\"\t\t\"STUN DURATION:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_boundless_strike_strike_flat_damage\"\t\"BONUS DAMAGE:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_boundless_strike_strike_crit_mult\"\t\"%CRITICAL DAMAGE:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery\"\t\t\t\t\t\t\"Jingu Mastery\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_Description\"\t\t\t\"Monkey King's attacks awaken the Jingu Bang's power. Upon the fourth hit on the same enemy hero, Monkey King earns %charges% charged attacks that have bonus damage and lifesteal.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_Lore\"\t\t\t\t\t\"Always sensitive to the moods of its master, the Jingu Bang radiates power when Sun Wukong's combat fervor is on full display.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_Note0\"\t\t\t\t\t\"Hitting an enemy with Boundless Strike adds to the hit counter.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_Note1\"\t\t\t\t\t\"Repeatedly hitting an enemy refreshes the Jingu Mastery debuff duration.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_Note2\"\t\t\t\t\t\"Hit charges on enemies cannot be dispelled.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_Note3\"\t\t\t\t\t\"Jingu Mastery buff on self can be dispelled.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_Note4\"\t\t\t\t\t\"Break disables the gaining of new stacks.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_Note5\"\t\t\t\t\t\"Break does not disable the bonuses from existing stacks.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_required_hits\"\t\t\t\"REQUIRED HITS:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_counter_duration\"\t\t\"COUNTER DURATION:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_bonus_damage\"\t\t\t\"BONUS DAMAGE:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_lifesteal\"\t\t\t\t\"%BONUS LIFESTEAL:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_jingu_mastery_max_duration\"\t\t\t\"BUFF DURATION:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_mischief\"\t\t\t\t\"Mischief\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_mischief_Description\"\t\"Changes Monkey King's shape to deceive opponents, using the environment nearby as inspiration for the disguise. Taking damage, attacking, or using any item or ability breaks Monkey King's disguise. Grants damage immunity for %invul_duration% seconds upon transforming.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_mischief_Lore\"\t\t\t\"Watch out for that tree.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_mischief_movespeed\"\t\t\"%BONUS MOVE SPEED:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_mischief_AbilityCooldown\"\t\"COOLDOWN:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_transfiguration\"\t\t\t\t\t\t\"Changing of the Guard\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_transfiguration_Description\"\t\t\t\"Monkey King can transform into any one of his soldiers during Wukong's command, taking its place for a %transfiguration_duration%s, becoming indistinguishable from other soldiers, and leaving another soldier in his stead. While transformed, Monkey King is invulnerable, but cannot attack or cast spells\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_untransform\"\t\t\t\t\"Revert Form\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_untransform_Description\"\t\"Reverts Monkey King's shape to his original form.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command\"\t\t\t\t\t\"Wukong's Command\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_abilitydraft_note\"\t\"Also grants <b>Mischief</b>\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_Description\"\t\t\"Monkey King creates a circular formation of soldiers that spread out from his position. If Monkey King leaves the area his soldiers disperse. The soldiers have Monkey King's attack that attacks at a fixed rate of %attack_speed%s, and only targets enemy Heroes. Monkey King is granted bonus armor for the spell's duration.<br><br>Monkey King can transform into any one of his soldiers during Wukong's command, taking its place for a short duration, becoming indistinguishable from other soldiers, and leaving another soldier in his stead.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_Facet_monkey_king_wukongs_faithful\"\t\"Monkey King's soldiers last longer and do not disperse unless he spends more than %leadership_time_buffer% seconds outside the area.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_Facet_monkey_king_transfiguration\"\t\"Grants the Changing of the Guard ability during Wukong's Command.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_scepter_description\"  \"Spawns a monkey soldier near Monkey King at regular intervals. Soldiers do not spawn while invisible or on trees. Soldiers only attack buildings when Monkey King himself is nearby. Soldiers can now gain Jingu Mastery charges independently.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_Lore\"\t\t\t\"Monkey King rips out a tuft of fur to blow at his enemies, charging each strand to transform into a copy of himself.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_Note0\"\t\t\t\"Soldiers do not receive Jingu Mastery bonuses.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_Note1\"\t\t\t\"Soldiers do not copy Basher or Abyssal.\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_damage_pct\"\t\"%SOLDIER DAMAGE:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_duration\"\t\t\"DURATION:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_bonus_armor\"\t\"BONUS ARMOR:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_scepter_spawn_interval\"\t\"SOLDIER SPAWN INTERVAL:\"",
    "\t\t\"DOTA_Tooltip_ability_monkey_king_wukongs_command_scepter_spawn_duration\"\t\"SOLDIER DURATION:\""
  ]
}
